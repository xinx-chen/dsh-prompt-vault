{
  "name": "dsh-prompt-vault",
  "version": "0.2.0",
  "description": "A local-first prompt vault for DeepSeek Harness: save reusable prompts, distill recurring patterns from conversations, search, tag, favorite, and copy.",
  "license": "MIT",
  "author": "xinx-chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinx-chen/dsh-prompt-vault.git"
  },
  "homepage": "https://github.com/xinx-chen/dsh-prompt-vault#readme",
  "bugs": {
    "url": "https://github.com/xinx-chen/dsh-prompt-vault/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "prompt-library",
    "prompt-management",
    "agent"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check host-vault.js && node --check host-routes.js && node --check host-tool.js && node --check host-skill.js && node --check client.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "host-vault.js",
    "host-routes.js",
    "host-tool.js",
    "host-skill.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.3-alpha.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
